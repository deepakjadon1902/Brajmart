# Delivery partner COD and pincode serviceability
# Set DELIVERY_PARTNER_PROVIDER=delhivery to use Delhivery live pincode API.
# If DELHIVERY_API_TOKEN is empty, checkout falls back to admin pincode rules.
DELIVERY_PARTNER_PROVIDER=delhivery
DELIVERY_PARTNER_NAME=Delhivery
DELIVERY_PARTNER_ENV=production
DELIVERY_ORIGIN_PINCODE=
DELIVERY_DEFAULT_SERVICEABLE=true
DELIVERY_DEFAULT_COD_ENABLED=true
DELIVERY_SERVICEABILITY_FALLBACK=database
DELIVERY_PINCODE_URL=https://track.delhivery.com/c/api/pin-codes/json/
DELIVERY_TRACKING_URL=https://track.delhivery.com/api/v1/packages/json/
DELIVERY_PUBLIC_TRACKING_URL=https://www.delhivery.com/track/package/
DELIVERY_PARTNER_API_TOKEN=
DELHIVERY_ENV=production
DELHIVERY_PINCODE_URL=https://track.delhivery.com/c/api/pin-codes/json/
DELHIVERY_TRACKING_URL=https://track.delhivery.com/api/v1/packages/json/
DELHIVERY_PUBLIC_TRACKING_URL=https://www.delhivery.com/track/package/
DELHIVERY_API_TOKEN=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

